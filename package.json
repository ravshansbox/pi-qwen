{
  "name": "@ravshansbox/pi-qwen",
  "version": "0.0.0",
  "description": "Qwen OAuth provider extension for pi",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravshansbox/pi-qwen.git"
  },
  "homepage": "https://github.com/ravshansbox/pi-qwen#readme",
  "bugs": {
    "url": "https://github.com/ravshansbox/pi-qwen/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "provider"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "files": [
    "index.ts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
